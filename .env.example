# Supabase / PostgreSQL Database Connection URL
# In Supabase: Project Settings -> Database -> Connection string (URI / Transaction pooler mode)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# Optional Client Keys for Supabase client SDK if using direct Supabase client:
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOi..."
